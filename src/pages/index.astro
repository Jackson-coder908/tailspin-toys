---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { sortGames } from '../lib/game-sorting';

export const prerender = true;

const games = sortGames(await getAllGames(getDatabase()), 'title-asc');
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <label for="game-sort" class="font-medium text-slate-200">Sort games</label>
            <select
              id="game-sort"
              class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="game-sort"
            >
              <option value="title-asc">Title (A-Z)</option>
              <option value="title-desc">Title (Z-A)</option>
              <option value="rating-desc">Star rating (highest first)</option>
            </select>
            <span class="text-sm text-slate-400">Unrated games appear last when sorting by rating.</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const sortControl = document.querySelector<HTMLSelectElement>('[data-testid="game-sort"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

  if (sortControl && gamesGrid) {
    sortControl.addEventListener('change', () => {
      const cards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
      const sort = sortControl.value;

      cards.sort((left, right) => {
        const leftTitle = left.dataset.gameTitle ?? '';
        const rightTitle = right.dataset.gameTitle ?? '';

        if (sort === 'title-desc') {
          return rightTitle.localeCompare(leftTitle);
        }

        if (sort === 'rating-desc') {
          const leftRating = left.dataset.gameRating ? Number(left.dataset.gameRating) : null;
          const rightRating = right.dataset.gameRating ? Number(right.dataset.gameRating) : null;

          if (leftRating === null && rightRating === null) {
            return leftTitle.localeCompare(rightTitle);
          }
          if (leftRating === null) {
            return 1;
          }
          if (rightRating === null) {
            return -1;
          }

          const ratingDifference = rightRating - leftRating;
          return ratingDifference === 0 ? leftTitle.localeCompare(rightTitle) : ratingDifference;
        }

        return leftTitle.localeCompare(rightTitle);
      });

      cards.forEach((card) => gamesGrid.append(card));
    });
  }
</script>
